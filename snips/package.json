{
  "name": "snips",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": "c",
        "path": "./snippets/c.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/cpp.json"
      },
      {
        "language": "go",
        "path": "./snippets/go.json"
      },
      {
        "language": ["plaintex", "tex"],
        "path": "./snippets/latex.json"
      }
    ]
  }
}
